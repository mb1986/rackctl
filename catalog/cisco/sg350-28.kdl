model {
  name "Cisco SG350-28"; short "SG350-28"
  kind "switch"; height 1; depth "half"; ports 26; sfps 4

  face #"""
     p ~[nnnnnn][nnnnnn] [g]-[s] [s]
     hhhhhhhh ~[nnnnnn][nnnnnn] [g]-[s] [s]
    """#

  legend {
    p power
    h short
    n port
    g port numbers="25-26" order="down"
    s sfp numbers="25-28" order="down"
    ~ fill
  }
}
