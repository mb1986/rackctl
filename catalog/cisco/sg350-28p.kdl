model {
  name "Cisco SG350-28P"; short "SG350-28P"
  kind "switch"; height 1; depth "half"; ports 28

  face #"""
     p ~[nnnnnn][nnnnnn] [g]-[s] [s]
     hhhhhhhhh ~[nnnnnn][nnnnnn] [g]-[s] [s]
    """#

  legend {
    p power
    h short
    n port
    g port numbers="25-26" order="down"
    s port media="sfp" numbers="25-28" order="down"
    ~ fill
  }
}
